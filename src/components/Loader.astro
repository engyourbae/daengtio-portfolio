---
import { profile } from '../data/site';
import LogoMark from './LogoMark.astro';
import WebArt from './WebArt.astro';
---
<!-- Hanya tampil saat <html class="loading">, yang dipasang skrip di <head> (sekali per sesi, tidak untuk reduced-motion). -->
<div class="loader" data-loader role="status" aria-live="polite">
  <WebArt class="loader__web" spokes={12} rings={6} />
  <div class="loader__core">
    <LogoMark size={44} />
    <p class="loader__count" aria-hidden="true"><span data-count>0</span><i>%</i></p>
    <div class="loader__bar" aria-hidden="true"><span data-bar></span></div>
    <p class="loader__label">Merajut halaman {profile.shortName}</p>
  </div>
</div>

<script>
  // Loader = layar prewarm (src/lib/prewarm.ts). Persen berasal dari pekerjaan yang benar-benar selesai
  // (font, decode gambar, lapisan GPU, ukur, animasi kering, frame pertama), bukan angka palsu.
  import { damp, measureNow, onFrame } from '../lib/engine';
  import { idle, prewarm, release } from '../lib/prewarm';

  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('[data-loader]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const bar = document.querySelector<HTMLElement>('[data-bar]');

  const finish = () => {
    if (!root.dataset.measured) measureNow(); // pengaman: jangan lanjut tanpa ukuran
    root.classList.add('motion-ready');
    root.classList.remove('loading');
    root.classList.add('ready');
    try { sessionStorage.setItem('dt-seen', '1'); } catch (e) { /* diblokir */ }
  };

  if (!loader || !root.classList.contains('loading') || !count || !bar) {
    finish();
  } else {
    const MIN = 900;   // ms, supaya hitungan terasa utuh di perangkat cepat (total biasanya ~1,3 sampai 2 detik)
    const HARD = 6500; // ms, pengaman sebelum pengaman 7 detik di <head>
    const t0 = performance.now();
    let real = 0;
    let ready = false;
    let shown = 0;
    let doneAt = 0;

    const pipeline = prewarm((d, t) => { real = t > 0 ? d / t : 0; }).catch((e) => console.error('[prewarm]', e));
    const guard = new Promise<void>((r) => window.setTimeout(r, HARD));
    void Promise.race([pipeline, guard]).then(() => { ready = true; });

    const off = onFrame((dt) => {
      const now = performance.now();
      const target = ready ? 100 : Math.min(99, real * 100);
      shown += (target - shown) * damp(14, dt);
      if (ready && shown > 99.5) shown = 100;
      const v = ready && shown >= 100 ? 100 : Math.min(99, Math.round(shown));
      count.textContent = String(v);
      bar.style.transform = `scaleX(${(shown / 100).toFixed(3)})`;
      if (v >= 100 && !doneAt && now - t0 >= MIN) doneAt = now;
      if (doneAt && now - doneAt > 260) {
        off();
        // Hero mulai beranimasi di bawah tirai yang menyingkap, lalu loader dilepas dari DOM.
        loader.classList.add('is-leaving');
        finish();
        window.setTimeout(() => loader.remove(), 1000);
        window.setTimeout(() => idle(release), 1800); // lapisan sementara dilepas saat browser senggang
      }
    });
  }
</script>
