---
import WebArt from './WebArt.astro';
---
<div class="backdrop" aria-hidden="true">
  <div class="bd" data-bd="halftone"><div class="backdrop__halftone"></div></div>
  <div class="bd bd--glow" data-glow="accent"></div>
  <div class="bd bd--glow" data-glow="blue"></div>
  <div class="bd bd--glow" data-glow="ink"></div>
  <div class="bd" data-bd="a"><WebArt class="backdrop__web backdrop__web--a" spokes={14} rings={7} /></div>
  <div class="bd" data-bd="b"><WebArt class="backdrop__web backdrop__web--b" spokes={10} rings={5} /></div>
  <canvas class="backdrop__dust" data-dust></canvas>
  <div class="backdrop__spot"></div>
  <div class="backdrop__vignette"></div>
</div>

<script>
  import { initBackdrop } from '../lib/backdrop';
  initBackdrop();
</script>
