---
import WebArt from './WebArt.astro';
---
<div class="backdrop" aria-hidden="true">
  <div class="backdrop__halftone"></div>
  <WebArt class="backdrop__web backdrop__web--a" spokes={14} rings={7} />
  <WebArt class="backdrop__web backdrop__web--b" spokes={10} rings={5} />
  <canvas class="backdrop__dust" data-dust></canvas>
  <div class="backdrop__vignette"></div>
</div>

<script>
  // Partikel debu halus, hanya di tema gelap. Berhenti saat tab tersembunyi atau reduced-motion.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dust]');
  const ctx = canvas?.getContext('2d');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (canvas && ctx && !reduce.matches) {
    type P = { x: number; y: number; r: number; vx: number; vy: number; a: number; ph: number };
    let w = 0, h = 0, dpr = 1, parts: P[] = [], raf = 0, running = false;
    const isDark = () => document.documentElement.dataset.theme === 'gelap';
    const make = (): P => ({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.4 + 0.3, vx: (Math.random() - 0.5) * 0.12, vy: -(Math.random() * 0.18 + 0.03), a: Math.random() * 0.5 + 0.15, ph: Math.random() * 6.28 });
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = innerWidth; h = innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(70, (w * h) / 22000));
      parts = Array.from({ length: n }, make);
    };
    const tick = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#cfd9ea';
      for (const p of parts) {
        p.x += p.vx + Math.sin(t / 2600 + p.ph) * 0.06; p.y += p.vy;
        if (p.y < -4) { p.y = h + 4; p.x = Math.random() * w; }
        if (p.x < -4) p.x = w + 4; else if (p.x > w + 4) p.x = -4;
        ctx.globalAlpha = p.a * (0.6 + 0.4 * Math.sin(t / 1800 + p.ph));
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
      }
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (!running && isDark() && !document.hidden) { running = true; raf = requestAnimationFrame(tick); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); ctx.clearRect(0, 0, w, h); };
    const sync = () => (isDark() && !document.hidden ? start() : stop());
    resize(); sync();
    addEventListener('resize', () => { resize(); });
    document.addEventListener('visibilitychange', sync);
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
