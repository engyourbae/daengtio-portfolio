---
import { skills } from '../data/site';
const items = skills.groups.flatMap((g) => g.items);
---
<div class="marquee-wrap" data-reveal="up">
<div class="marquee" aria-hidden="true" data-cursor="Tahan">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <ul class="marquee__list">
        {items.map((t) => <li>{t}<svg viewBox="0 0 24 24" class="marquee__sep"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg></li>)}
      </ul>
    ))}
  </div>
</div>
</div>
