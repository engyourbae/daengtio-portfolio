---
import { skills } from '../data/site';
---
<section class="section hairline" id="skill" aria-labelledby="skill-title">
  <div class="wrap">
    <h2 id="skill-title">{skills.title}</h2>
    <div class="skills__grid">
      {skills.groups.map((g) => (
        <div class="skill-group">
          <h3>{g.name}</h3>
          <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>
