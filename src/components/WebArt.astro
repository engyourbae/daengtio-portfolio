---
/**
 * Jaring laba-laba dibuat di build (tanpa aset gambar): jari-jari + lingkar yang melengkung ke dalam.
 * Warna mengikuti currentColor / --web. pathLength=1 supaya bisa dianimasikan "menggambar diri".
 */
interface Props { spokes?: number; rings?: number; class?: string; sag?: number }
const { spokes = 12, rings = 6, class: cls, sag = 0.16 } = Astro.props;
const R = 100;
const pt = (a: number, r: number) => [Math.cos(a) * r, Math.sin(a) * r];
const f = (n: number) => n.toFixed(2);
let spokeD = '';
for (let i = 0; i < spokes; i++) {
  const [x, y] = pt((i / spokes) * Math.PI * 2 - Math.PI / 2, R);
  spokeD += `M0 0L${f(x)} ${f(y)}`;
}
let ringD = '';
for (let j = 1; j <= rings; j++) {
  const r = (j / rings) * R * (0.92 + j * 0.013);
  for (let i = 0; i < spokes; i++) {
    const a0 = (i / spokes) * Math.PI * 2 - Math.PI / 2;
    const a1 = ((i + 1) / spokes) * Math.PI * 2 - Math.PI / 2;
    const [x0, y0] = pt(a0, r);
    const [x1, y1] = pt(a1, r);
    const [cx, cy] = pt((a0 + a1) / 2, r * (1 - sag));
    ringD += `M${f(x0)} ${f(y0)}Q${f(cx)} ${f(cy)} ${f(x1)} ${f(y1)}`;
  }
}
---
<svg class:list={['web-art', cls]} viewBox="-102 -102 204 204" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true" focusable="false">
  <path class="web-art__spokes" d={spokeD} pathLength="1" stroke-width="0.7" />
  <path class="web-art__rings" d={ringD} pathLength="1" stroke-width="0.55" />
</svg>
