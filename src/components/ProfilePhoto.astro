---
import { photos } from '../data/site';
const { main, alt, width, height, altWidth, altHeight, altText } = photos;
---
{alt ? (
  <button class="photo" type="button" data-photo aria-pressed="false" aria-label="Ganti foto">
    <img class="photo__main" src={main} width={width} height={height} alt={altText} decoding="async" fetchpriority="high" />
    <img class="photo__alt" src={alt} width={altWidth} height={altHeight} alt="" decoding="async" />
  </button>
) : (
  <div class="photo">
    <img src={main} width={width} height={height} alt={altText} decoding="async" fetchpriority="high" />
  </div>
)}

<script>
  // Desktop: hover lewat CSS. Layar sentuh dan keyboard: tap/Enter untuk berganti foto.
  const el = document.querySelector<HTMLButtonElement>('[data-photo]');
  el?.addEventListener('click', () => {
    const on = el.classList.toggle('is-alt');
    el.setAttribute('aria-pressed', String(on));
  });
</script>
