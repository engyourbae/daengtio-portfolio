<script>
  // Animasi scroll dua arah: reveal berulang, counter, parallax, marquee, miring tipis, gelombang teks.
  // Konten hanya disembunyikan CSS bila <html class="motion"> (dipasang skrip di <head>); bila skrip ini gagal,
  // pengaman di <head> mencabut kelas itu dan semua konten tetap terlihat.
  import { initReveal, initCounters, initParallax, initMarquee, initSkew, initLines, initWave } from '../lib/motion';
  try {
    initLines();
    initReveal();
    initCounters();
    initParallax();
    initMarquee();
    initSkew();
    initWave();
  } catch (e) {
    document.documentElement.classList.remove('motion');
    console.error('[motion]', e);
  }
</script>
