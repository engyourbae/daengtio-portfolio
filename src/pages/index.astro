---
import Base from '../layouts/Base.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import { profile, education, projects, skills, asset } from '../data/site';
const nav = [['about', 'Tentang'], ['projects', 'Project'], ['skills', 'Skill'], ['contact', 'Kontak']];
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<Base>
  <nav class="nav" aria-label="Utama">
    <a href="#top" aria-label="Beranda"><img src={asset('brand/brand-logo.svg')} alt="" width="28" height="28" /></a>
    {nav.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
    <button id="theme" type="button" aria-label="Ganti tema terang/gelap">Tema</button>
  </nav>
  <main id="top">
    <div class="wrap hero">
      <div>
        {profile.available && <p class="status"><i></i>Terbuka untuk freelance</p>}
        <h1>{profile.headline}</h1>
        <p class="lead">{profile.name}, {profile.title.toLowerCase()}.</p>
        <div class="row">
          <a class="btn pri" href="#projects">Lihat Project <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg></a>
          <a class="btn" href="#contact">Hubungi Saya</a>
        </div>
      </div>
      <figure><img src={asset('profile/profile-action.webp')} alt="Daeng Tio Waldi dalam pose aksi bergaya superhero" width="1000" height="1094" fetchpriority="high" /></figure>
    </div>
    <section id="about"><div class="wrap about">
      <ProfilePhoto />
      <div>
        <h2>Tentang</h2><p>{profile.bio}</p>
        {education.map((e) => <div class="edu"><strong>{e.major}</strong><br />{e.school}<br /><small>{e.note}</small></div>)}
      </div>
    </div></section>
    <section id="projects"><div class="wrap">
      <h2>Project</h2>
      <div class="grid">
        {projects.map((p) => (
          <a class:list={['card', { big: p.featured }]} href={p.url} target="_blank" rel="noopener noreferrer">
            <div class="thumb">{p.logo ? <img src={asset(p.logo)} alt={`Logo ${p.title}`} width="480" height="480" loading="lazy" /> : <span aria-hidden="true">{p.title[0]}</span>}</div>
            <div><h3>{p.title}</h3>{p.desc && <p>{p.desc}</p>}<div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div></div>
          </a>
        ))}
      </div>
    </div></section>
    <section id="skills"><div class="wrap">
      <h2>Skill</h2>
      <div class="skills">{Object.entries(skills).map(([g, l]) => <div><h3>{g}</h3><ul>{l.map((s) => <li>{s}</li>)}</ul></div>)}</div>
    </div></section>
    <section id="contact"><div class="wrap">
      <h2>Kontak</h2>
      <p class="lead">Punya ide atau butuh aplikasi? Kirim pesan, atau langsung hubungi lewat email dan Instagram.</p>
      {profile.formEndpoint && (
        <form id="cf" novalidate data-endpoint={profile.formEndpoint}>
          <label>Nama<input name="name" required autocomplete="name" /></label>
          <label>Email<input name="email" type="email" required autocomplete="email" /></label>
          <label>Subjek<input name="subject" required /></label>
          <label>Pesan<textarea name="message" rows="5" required></textarea></label>
          <button class="btn pri" type="submit">Kirim Pesan</button>
          <p class="msg" role="status" aria-live="polite"></p>
        </form>
      )}
      <div class="row" style="margin-top:1.5rem">
        <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn" href={profile.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div></section>
  </main>
  <footer><div class="wrap row"><span>© {new Date().getFullYear()} {profile.name}</span><a href="#top">Kembali ke atas</a></div></footer>
  <script>
    const f = document.querySelector<HTMLFormElement>('#cf');
    f?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const m = f.querySelector<HTMLElement>('.msg')!, btn = f.querySelector('button')!;
      const set = (t: string, c = '') => { m.textContent = t; m.className = 'msg ' + c; };
      if (!f.checkValidity()) { set('Lengkapi semua kolom dengan benar.', 'err'); f.reportValidity(); return; }
      btn.disabled = true; set('Mengirim…');
      try {
        const r = await fetch(f.dataset.endpoint!, { method: 'POST', headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(f))) });
        if (!r.ok) throw new Error();
        f.reset(); set('Pesan terkirim. Terima kasih!', 'ok');
      } catch { set('Gagal mengirim. Coba lagi atau gunakan email.', 'err'); }
      btn.disabled = false;
    });
  </script>
</Base>
